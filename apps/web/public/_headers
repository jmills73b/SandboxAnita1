# Cloudflare Pages reads this file at deploy time. The point: index.html
# must always be re-fetched (it's what points the browser at the current
# build's hashed JS/CSS filenames), while the hashed asset files themselves
# are safe to cache forever since a content change gives them a new name.
#
# no-store (not no-cache): iOS Safari doesn't reliably revalidate a
# no-cache response before reuse, which showed up as a stale post-login
# screen after a deploy. no-store forbids caching the response at all, so
# there's nothing to serve stale — the file is 0.4kB, so there's no real
# cost to always re-fetching it.

/
  Cache-Control: no-store

/index.html
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable
