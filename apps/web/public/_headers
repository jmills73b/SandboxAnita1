# Cloudflare Pages reads this file at deploy time. The point: index.html
# must always be re-fetched (it's what points the browser at the current
# build's hashed JS/CSS filenames), while the hashed asset files themselves
# are safe to cache forever since a content change gives them a new name.

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
